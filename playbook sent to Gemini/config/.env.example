# Copy this file to /etc/wazuh-gemini-forwarder.env on the Wazuh host
# and fill in your own values. Never commit a real .env file.

# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Alias that always points at Google's current recommended Flash model
GEMINI_MODEL=gemini-flash-latest

# Generate with: openssl rand -hex 32
LOCAL_API_KEY=your_generated_hex_key_here
LOCAL_API_HEADER=X-API-Key

WAZUH_ALERTS_FILE=/var/ossec/logs/alerts/alerts.json
ANALYSES_FILE=/var/lib/wazuh-gemini-forwarder/analyses.jsonl
STATE_FILE=/var/lib/wazuh-gemini-forwarder/state.json
SYSTEM_PROMPT_FILE=/opt/wazuh-gemini-forwarder/system_prompt.txt

BIND_HOST=192.168.50.50
BIND_PORT=8010

REQUEST_TIMEOUT_SECONDS=120
FORWARD_EXISTING_ON_FIRST_START=false
INCLUDE_FILE_DIFF=false
LOG_LEVEL=INFO
